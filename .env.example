# Household login (single account, no self-registration).
AUTH_USERNAME=michal

# Generate with: npm run hash-password -- "your-password"
# (output is base64-encoded on purpose — the raw hash contains `$`
# characters that Docker Compose silently corrupts when parsing .env files)
AUTH_PASSWORD_HASH=

# Secret used to encrypt the session cookie. Required in production.
# In dev, nuxt-auth-utils generates one into .env automatically if missing.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Optional: override where the SQLite database file is stored.
# RECIPE_DB_PATH=./data/recipes.sqlite
